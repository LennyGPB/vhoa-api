NODE_ENV=development
PORT=3000

# Neon : URL « pooled » (avec -pooler). Les migrations utilisent automatiquement l'URL directe.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# DIRECT_DATABASE_URL=  (facultatif, sinon déduite de DATABASE_URL)

# Secret des jetons de session (48+ caractères aléatoires) :
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# URL publique du bucket (domaine personnalisé Cloudflare recommandé, en https)
R2_PUBLIC_BASE_URL=

# Connexion Apple : bundle id(s) iOS, séparés par des virgules
APPLE_BUNDLE_IDS=com.vhoa.app
# Connexion Google : client IDs (web, iOS, Android), séparés par des virgules
GOOGLE_CLIENT_IDS=

# RevenueCat
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_SECRET_KEY=
REVENUECAT_ENTITLEMENT=premium

# Expo Push (facultatif : jeton d'accès si la sécurité push est activée sur expo.dev)
EXPO_ACCESS_TOKEN=

# Conversions ffmpeg en parallèle (1 sur une petite instance)
MEDIA_CONCURRENCY=1

# Origines web autorisées (version web de l app), séparées par des virgules
CORS_ORIGINS=http://localhost:3003
